# Charging speed (vendor.lineage.health IFastCharge): 1 = 5V only, 2A, no PPS
on property:vendor.all.modules.ready=1 && property:vendor.all.devices.ready=1
    chown system system /sys/devices/platform/google,charger/usb_5v_only
    chmod 0660 /sys/devices/platform/google,charger/usb_5v_only
